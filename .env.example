# Production domain, without a trailing slash. Used for canonical URLs, sitemap, robots and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Optional: Google Tag Manager container ID (GTM-XXXXXXX). Leave empty to disable all tracking scripts.
NEXT_PUBLIC_GTM_ID=

# Optional: Google Search Console HTML-tag verification token (content value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
